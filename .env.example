PORT=8080
APP_URL=https://replace-with-public-northflank-endpoint
DATABASE_URL=postgresql://user:password@host:5432/cogia
PGSSL=require
JWT_SECRET=replace-with-at-least-32-random-characters
WORKSPACE_ROOT=/workspaces
STUDIO_RUNNER_URL=http://cogia-studio-runner:8090/run
STUDIO_RUNNER_TOKEN=replace-with-secret-manager-value
OPENAI_API_KEY=replace-with-secret-manager-value
OPENAI_MODEL=replace-with-authorized-model
